# ============================================
# NEXT.JS ENVIRONMENT TEMPLATE
# Copy this file to .env.local and fill in your values
# Never commit .env.local to git!
# ============================================

# ===== APPLICATION ENVIRONMENT =====
NODE_ENV=development

# ===== FRONTEND / PUBLIC VARIABLES =====
# These are exposed to the browser (prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# ===== DATABASE CONFIGURATION =====
# Only for backend processes/API routes
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=pelayanan_cuci_ac

# ===== API SERVER CONFIGURATION =====
API_PORT=5001

# ===== SECURITY =====
# JWT Secret for backend authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ===== THIRD-PARTY INTEGRATIONS =====
# Gemini API (optional)
GEMINI_API_KEY=your_gemini_api_key

# Fonnte WhatsApp Gateway API Token
FONNTE_API_KEY=your_fonnte_api_key

# ===== APPLICATION URL =====
# Used for links in emails, etc.
APP_URL=http://localhost:3000

# ===== SMTP EMAIL CONFIGURATION (For Forgot Password) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="CoolAir Pro <noreply@coolairpro.com>"

